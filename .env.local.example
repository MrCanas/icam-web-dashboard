# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` está en .gitignore y no debe commitearse.

# --- Supabase (Dashboard → Project Settings → API) ---
# La app Next.js usa el prefijo NEXT_PUBLIC_* en el navegador.
# Los scripts en scripts/actas/ aceptan SUPABASE_* o NEXT_PUBLIC_SUPABASE_*.

SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor, scripts y Route Handlers. Nunca exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# JWT de sesión del portal (cookie icam-auth). Mínimo 32 caracteres aleatorios.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=

# Base URL para npm run auth:test-login (opcional; default http://localhost:3000)
# AUTH_TEST_BASE_URL=http://localhost:3000

# Email con fila en auth.users + org_member para npm run actas:test-auth-bridge
ACTAS_AUTH_BRIDGE_TEST_EMAIL=

# --- Postgres (scripts/actas/monday-load.ts, transacciones) ---
# Usa Session mode (puerto 5432) del pooler — IPv4. Evita db.<ref>.supabase.co en Windows sin IPv6.
# Dashboard → Database → Connection string → Session, o `npx supabase link` (pooler-url en .temp).
DATABASE_URL=
# Si DATABASE_URL apunta a db.*.supabase.co, monday-load usa supabase/.temp/pooler-url automáticamente.
DATABASE_POOLER_URL=
SUPABASE_DB_PASSWORD=

# --- Monday.com (módulo Monday) ---
MONDAY_API_TOKEN=
# Opcional: IDs de tableros separados por coma
MONDAY_BOARD_IDS=
MONDAY_API_VERSION=2026-04
# Espacio de trabajo de Actas
MONDAY_WORKSPACE_ID_ACTAS=8115808
# Tablero de muestra para mapeo de elementos (ver docs/actas/05-monday-inventory.md)
MONDAY_SAMPLE_BOARD_ID=18401743922

# --- Microsoft 365 / Graph (app-only, client credentials) ---
# Email transaccional (Mail.Send) y descarga de SharePoint (Sites.Read.All / Files.Read.All).
# Permisos de APLICACIÓN concedidos + consentimiento admin en el registro de Azure.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Buzón remitente (p. ej. noreply@imparcapital.com)
EMAIL_FROM=

# --- Cron de sincronización del portfolio financiero ---
# Secreto para invocar /api/cron/*. Vercel Cron envía `Authorization: Bearer <CRON_SECRET>`
# automáticamente cuando esta variable está definida en el entorno del proyecto.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Carpeta de SharePoint (mínimo privilegio Sites.Selected: la app tiene rol de lectura solo
# sobre esta carpeta). El cron localiza dentro el maestro más reciente. Obtén los IDs desde
# Graph Explorer al conceder el permiso; verifica con `npm run portfolio:check-sharepoint`.
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_ITEM_ID=
# Opcional: subcadena para identificar el maestro dentro de la carpeta (por defecto "MAESTRO").
SHAREPOINT_FILE_NAME_MATCH=

# --- Zoho CRM · Avance de obra ---
# LECTURA automática (traer las promociones y su avance); ESCRITURA solo sobre
# cambios ya aprobados a mano en /dashboard/pm/avance-obra: ningún cron ni ruta
# automática escribe en Zoho.
# Self Client en https://api-console.zoho.eu (o .com) con scope
# ZohoCRM.settings.READ,ZohoCRM.modules.ALL. Paso a paso en
# docs/pm/01-avance-obra.md, sección «Conectar la API de Zoho».
# OJO al centro de datos: el refresh token solo vale en el dominio que lo emitió
# y el equivocado devuelve invalid_client sin más explicación.
ZOHO_ACCOUNTS_URL=
# El api_domain que devuelve el canje del grant code (p. ej. https://www.zohoapis.eu).
ZOHO_API_DOMAIN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Nombre API del módulo de Promociones. Lo averigua `npm run pm:zoho-explore`.
ZOHO_MODULO_PROMOCIONES=
